# ---- Required ----
# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers). Use a NEW password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/test?retryWrites=true&w=majority
# Admin login. Generate the hash + a JWT secret with:  npm run hash-password -- "your-strong-password"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=scrypt:...:...
JWT_SECRET=at-least-32-random-characters
# Public URL of the site (used for sitemap, SEO and Google Jobs). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://dishahire.vercel.app

# ---- Optional: email alerts via Resend (https://resend.com) ----
RESEND_API_KEY=
# Where alerts go (comma-separated). Defaults to dishahire.0818@gmail.com
ALERT_EMAIL_TO=
# Sender. Without a verified domain, Resend only allows onboarding@resend.dev -> your own Resend account email.
ALERT_EMAIL_FROM=DishaHire Website <onboarding@resend.dev>
